EDISK_APP_NAME=eDisk API
EDISK_ENVIRONMENT=development
EDISK_LOG_LEVEL=INFO
EDISK_DATABASE_URL=postgresql+asyncpg://edisk_app:change-me@127.0.0.1:5432/edisk_dev
EDISK_REDIS_URL=redis://:change-me@127.0.0.1:6379/0
EDISK_OPENBAO_URL=http://127.0.0.1:8200
# Use only a restricted application token. Never use the OpenBao root token.
EDISK_OPENBAO_TOKEN=
# Prefer AppRole credentials in production and local automation.
EDISK_OPENBAO_ROLE_ID=
EDISK_OPENBAO_SECRET_ID=
EDISK_DEPENDENCY_TIMEOUT_SECONDS=2.0
# start-api.ps1 loads this from .secrets/jwt_secret.txt. Set it directly in other runtimes.
# Generate a random value with at least 32 characters. Never commit the real value.
EDISK_AUTH_JWT_SECRET=
EDISK_AUTH_ACCESS_TOKEN_MINUTES=15
EDISK_AUTH_REFRESH_TOKEN_DAYS=30
EDISK_AUTH_ISSUER=edisk-api
EDISK_AUTH_AUDIENCE=edisk-app
